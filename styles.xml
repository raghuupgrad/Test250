<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">28sp</item>
        <item name="cornerRadius">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Digit">
        <item name="android:backgroundTint">@color/gray_dark</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CalcButton.Function">
        <item name="android:backgroundTint">@color/gray_light</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="android:backgroundTint">@color/orange</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
